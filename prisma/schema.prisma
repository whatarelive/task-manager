// Configuracíon
generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Modelos
model User {
  id          String @id @default(uuid())
  username    String @unique
  email       String @unique
  password    String

  // Relaciones
  tasks       Task[]
}

model Task {
  id          String @id @default(uuid())
  title       String
  status      Boolean @default(false)
  createAt    DateTime @default(now())
  finalAt     DateTime

  // Relaciones
  user        User @relation(fields: [userId], references: [id])
  userId      String

  tags        Tags[]
}

model Tags {
  id          String @id @default(uuid())
  name        String
  color       String

  // Relaciones
  tasks        Task[]
}
