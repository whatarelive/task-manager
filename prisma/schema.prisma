// Configuracíon
generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Modelos
model User {
  id          String @id @default(uuid())
  username    String @unique
  email       String @unique
  password    String
}
